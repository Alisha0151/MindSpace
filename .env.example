# Copy to .env and replace every placeholder. Never commit .env.
# These variables configure the Spring Boot backend and Docker Compose (written, not yet run; see README "Verification status").

# --- PostgreSQL ---
POSTGRES_DB=mindspace
POSTGRES_USER=mindspace
POSTGRES_PASSWORD=change-me

# --- Backend ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mindspace
SPRING_DATASOURCE_USERNAME=mindspace
SPRING_DATASOURCE_PASSWORD=change-me
# Long random value (32+ bytes) used to sign short-lived access tokens
MINDSPACE_JWT_SECRET=change-me-to-a-long-random-value
# Comma-separated list of allowed browser origins
MINDSPACE_CORS_ALLOWED_ORIGINS=http://localhost:5173
# BCrypt work factor
MINDSPACE_BCRYPT_STRENGTH=12
# true only when served over HTTPS
MINDSPACE_COOKIE_SECURE=false

# --- Database test runner ---
# MINDSPACE_TEST_PG_PORT=55433
# PG_BIN=/usr/lib/postgresql/16/bin
